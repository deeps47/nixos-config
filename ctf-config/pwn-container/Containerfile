FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    gdb \
    gdbserver \
    file \
    strace \
    ltrace \
    binutils \
    patchelf \
    gcc \
    g++ \
    make \
    python3 \
    python3-pip \
    tmux \
    vim \
    curl \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    pwntools \
    ropgadget \
    capstone \
    keystone-engine \
    unicorn

WORKDIR /work

CMD ["/bin/bash"]
